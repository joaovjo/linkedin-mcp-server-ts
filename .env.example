# LinkedIn MCP Server (TypeScript / Bun) Environment Variables
# Copy to .env and fill in values

# Persistent browser profile directory (default: ~/.linkedin-mcp/profile)
USER_DATA_DIR=~/.linkedin-mcp/profile

# Browser mode for scrape WebView (Bun.WebView is headless-only; login uses Chrome attach)
HEADLESS=true

# Logging level
LOG_LEVEL=WARNING

# Transport: stdio | streamable-http (default: stdio when non-TTY)
TRANSPORT=

# Page-op timeout in milliseconds
TIMEOUT=5000

# Per-tool timeout in seconds
TOOL_TIMEOUT=180

# Login wait (seconds; 0 = no limit)
LOGIN_TIMEOUT=1800

# Inline wait for login during a tool call (seconds, max 45)
LOGIN_INLINE_WAIT=25

# Auto-import cookies.json when no live session
AUTO_IMPORT_FROM_BROWSER=true

# Soft update check
LINKEDIN_MCP_CHECK_FOR_UPDATES=true

# Optional Chrome path / user agent / viewport
CHROME_PATH=
USER_AGENT=
VIEWPORT=1280x720

# Chrome remote-debugging port used by --login
DEBUG_PORT=9222

# HTTP transport
HOST=127.0.0.1
PORT=8000
HTTP_PATH=/mcp
