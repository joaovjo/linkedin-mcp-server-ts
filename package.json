{
  "name": "linkedin-mcp-server-ts",
  "version": "0.2.0",
  "description": "High-performance TypeScript & Bun MCP server for LinkedIn scraping and automation",
  "module": "src/index.ts",
  "bin": {
    "linkedin-mcp-server-ts": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaovjo/linkedin-mcp-server-ts.git"
  },
  "bugs": {
    "url": "https://github.com/joaovjo/linkedin-mcp-server-ts/issues"
  },
  "homepage": "https://github.com/joaovjo/linkedin-mcp-server-ts#readme",
  "scripts": {
    "dev": "bun run src/index.ts --transport streamable-http",
    "start": "bun run src/index.ts",
    "login": "bun run src/index.ts --login",
    "logout": "bun run src/index.ts --logout",
    "status": "bun run src/index.ts --status",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun test tests/e2e",
    "test:coverage": "bun test --coverage",
    "docs": "typedoc --out docs src/index.ts",
    "docs:serve": "bunx serve docs",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:fix:unsafe": "biome check --write --unsafe",
    "format": "biome format --write"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "latest",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "mcp",
    "linkedin",
    "scraping",
    "model-context-protocol",
    "bun",
    "typescript"
  ],
  "license": "MIT"
}
