{
  "name": "mcp-server-linkedin",
  "version": "0.1.0",
  "description": "MCP server for LinkedIn scraping and automation (TypeScript + Bun port)",
  "module": "src/index.ts",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "bun run src/index.ts --transport streamable-http",
    "start": "bun run src/index.ts",
    "login": "bun run src/index.ts --login",
    "logout": "bun run src/index.ts --logout",
    "status": "bun run src/index.ts --status",
    "test": "bun test",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/ tests/"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0"
  },
  "keywords": ["mcp", "linkedin", "scraping", "model-context-protocol", "bun"],
  "license": "Apache-2.0"
}
