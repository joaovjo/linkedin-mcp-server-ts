{
  "name": "linkedin-mcp-server-ts",
  "version": "0.1.0",
  "description": "High-performance TypeScript & Bun MCP server for LinkedIn scraping and automation",
  "module": "src/index.ts",
  "bin": {
    "linkedin-mcp-server-ts": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaovjo/linkedin-mcp-server-ts.git"
  },
  "bugs": {
    "url": "https://github.com/joaovjo/linkedin-mcp-server-ts/issues"
  },
  "homepage": "https://github.com/joaovjo/linkedin-mcp-server-ts#readme",
  "scripts": {
    "dev": "bun run src/index.ts --transport streamable-http",
    "start": "bun run src/index.ts",
    "login": "bun run src/index.ts --login",
    "logout": "bun run src/index.ts --logout",
    "status": "bun run src/index.ts --status",
    "test": "bun test",
    "lint": "bunx @biomejs/biome check src/ tests/",
    "lint:fix": "bunx @biomejs/biome check --write src/ tests/",
    "format": "bunx @biomejs/biome format --write src/ tests/"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0"
  },
  "keywords": [
    "mcp",
    "linkedin",
    "scraping",
    "model-context-protocol",
    "bun",
    "typescript"
  ],
  "license": "MIT"
}
